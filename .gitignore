# ──────────────────────────────────────────────
# Root .gitignore — Math Discovery Engine
# ──────────────────────────────────────────────

# ── Python ──────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Node / Next.js ──────────────────────────
node_modules/
.next/
.turbo/
out/
dist/

# ── Environment variables ────────────────────
.env
.env.*
!.env.example

# ── OS artefacts ─────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
